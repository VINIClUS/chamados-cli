{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VINIClUS/chamados-cli/contracts/backup-manifest.schema.json",
  "title": "Chamados backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "revision", "ref", "postgres_major", "created_at", "sha256", "members"],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"type": "string", "enum": ["staging", "production"]},
    "revision": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "ref": {"type": "string", "minLength": 1},
    "postgres_major": {
      "oneOf": [
        {"type": "integer", "minimum": 10},
        {"type": "string", "pattern": "^(1[0-9]|[2-9][0-9]+)$"}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "size"],
        "properties": {
          "name": {"type": "string", "enum": ["database.dump", "attachments.tar"]},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
